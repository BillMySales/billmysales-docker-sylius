# Production environment. Usage: cp .env.prod.example .env, fill in the
# REQUIRED values, then docker compose up -d --build
# Commented-out lines show the default value.

# ---------------------------------------------------------------------------
# Optional services, comma separated: backup, mailpit (dev only), tools
# (console).
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=backup
#COMPOSE_PROJECT_NAME=sylius

# Optional overrides (see overrides/*.yaml), combined with ":", e.g.
#COMPOSE_FILE=compose.yaml:overrides/traefik.yaml:overrides/local-dirs.yaml
# overrides/traefik.yaml: publish through an existing Traefik (then set
# SITE_ADDRESS=:80 below).
#TRAEFIK_HOST=shop.example.com
#TRAEFIK_NETWORK=shared_network
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt
# overrides/local-dirs.yaml: data in local directories instead of volumes.
#DATA_DIR=./data

# ---------------------------------------------------------------------------
# Site and network
# ---------------------------------------------------------------------------
# REQUIRED. Public URL of the shop (the admin is <url>/admin, the APIs
# <url>/api/v2). Used for links built outside a request (emails sent by the
# worker or the console); applied on every `up`.
SYLIUS_URL=https://shop.example.com
# Caddy site address: a domain gets an automatic Let's Encrypt certificate
# (DNS must point here and ports 80/443 must be reachable). Use ":80" behind
# another TLS-terminating proxy, or "localhost" for local HTTPS.
SITE_ADDRESS=shop.example.com
# Interface to publish ports on: 0.0.0.0 = all (public server).
HTTP_BIND=0.0.0.0
#HTTP_PORT=80
#HTTPS_PORT=443
#TIMEZONE=America/Santiago

# ---------------------------------------------------------------------------
# Secrets and credentials (REQUIRED, use long random values: openssl rand -hex 32)
# ---------------------------------------------------------------------------
# Symfony secret (CSRF tokens, signed URLs, remember-me cookies).
APP_SECRET=
# Passphrase of the Admin/Shop API JWT key pair (generated on the first run
# in the `keys` volume; changing it later needs new keys, see README).
JWT_PASSPHRASE=
DB_PASSWORD=
DB_ROOT_PASSWORD=
# First admin user (created on the first run; its password is set only then).
SYLIUS_ADMIN_EMAIL=
SYLIUS_ADMIN_PASSWORD=
#DB_USER=sylius
#DB_NAME=sylius

# ---------------------------------------------------------------------------
# Store (initial settings: each one is created only if missing, later changes
# in the admin are kept)
# ---------------------------------------------------------------------------
#SYLIUS_STORE_NAME=Sylius
#SYLIUS_CURRENCY=CLP
#SYLIUS_COUNTRY=CL
#SYLIUS_ZONE_NAME=Chile
# Tax rate of the zone (%) for the "standard" tax category; empty = none.
#SYLIUS_TAX_RATE=19
#SYLIUS_TAX_NAME=IVA
#SYLIUS_TAX_CATEGORY_NAME=Afecto
# Prices include tax (as usual in Chile).
#SYLIUS_PRICES_INCLUDE_TAX=true
#SYLIUS_SHIPPING_NAME=Despacho
#SYLIUS_PAYMENT_NAME=Transferencia bancaria

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------
# Sylius core (sylius/sylius) and the Sylius-Standard project it's built on
# (image/Dockerfile). After changing them, `docker compose up -d --build`
# rebuilds and `setup` runs the migrations. Back up first, and read Sylius's
# UPGRADE-2.x.md for minor versions.
#SYLIUS_VERSION=2.2.9
#SYLIUS_STANDARD_VERSION=2.2.4
# Locale of the store, set in the image at build time (Sylius validates
# translations in it): changing it rebuilds the image. Use it before the
# first install.
#SYLIUS_LOCALE=es_CL
#PHP_VERSION=8.5
#SYLIUS_IMAGE=sylius-fpm
#MARIADB_VERSION=11.4
#CADDY_VERSION=2.11
#MAILPIT_VERSION=v1.31

# ---------------------------------------------------------------------------
# Mail (SMTP): order and shipment confirmations, account verification,
# password resets, contact form. No emails without SMTP_HOST.
# ---------------------------------------------------------------------------
SMTP_HOST=
#SMTP_PORT=587
# tls or empty (STARTTLS when the server offers it, usually port 587),
# ssl (SMTPS, port 465) or none (never TLS).
#SMTP_SECURE=
#SMTP_USER=
#SMTP_PASSWORD=
# Sender address and name of the emails.
#SMTP_FROM=no-reply@example.com
#SMTP_FROM_NAME=Sylius

# ---------------------------------------------------------------------------
# Scheduled work and backups
# ---------------------------------------------------------------------------
# Seconds between runs of the cron service (unpaid orders, expired carts).
#CRON_INTERVAL=3600
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP_DAYS=7

# ---------------------------------------------------------------------------
# PHP, resources and logs
# ---------------------------------------------------------------------------
#PHP_MEMORY_LIMIT=512M
#PHP_MAX_EXECUTION_TIME=120
#PHP_DISPLAY_ERRORS=Off
# 1 = PHP checks files for changes (only useful when editing code in place).
#PHP_OPCACHE_VALIDATE_TIMESTAMPS=0
#PHP_FPM_MAX_CHILDREN=10
#PHP_FPM_START_SERVERS=2
#PHP_FPM_MIN_SPARE_SERVERS=1
#PHP_FPM_MAX_SPARE_SERVERS=4
#PHP_FPM_MAX_REQUESTS=500
#UPLOAD_MAX_SIZE=32M
#DB_MEMORY_LIMIT=1g
#SETUP_MEMORY_LIMIT=768m
#PHP_MEMORY_LIMIT_CONTAINER=1g
#WORKER_MEMORY_LIMIT=512m
#CRON_MEMORY_LIMIT=512m
#CONSOLE_MEMORY_LIMIT=768m
#CADDY_MEMORY_LIMIT=256m
#BACKUP_MEMORY_LIMIT=512m
#LOG_MAX_SIZE=10m
#LOG_MAX_FILE=3
