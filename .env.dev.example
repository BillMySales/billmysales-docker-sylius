# Development environment. Usage: cp .env.dev.example .env && docker compose up -d --build
# Every variable is documented in .env.prod.example.

# Mailpit catches all outgoing mail: http://localhost:8025
COMPOSE_PROFILES=mailpit

# Local URL (shop at /, admin at /admin), plain HTTP on port 8112.
SYLIUS_URL=http://localhost:8112
SITE_ADDRESS=:80
HTTP_PORT=8112
HTTPS_PORT=8412
MAILPIT_PORT=8025
PHP_DISPLAY_ERRORS=On

# Dev-only secrets and credentials.
APP_SECRET=dev-app-secret
JWT_PASSPHRASE=dev-jwt-passphrase
DB_PASSWORD=sylius
DB_ROOT_PASSWORD=root
SYLIUS_ADMIN_EMAIL=admin@example.com
SYLIUS_ADMIN_PASSWORD=admin12345

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=none
SMTP_FROM=shop@example.com
SMTP_FROM_NAME=Tienda
